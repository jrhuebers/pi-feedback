{
  "name": "pi-feedback",
  "version": "0.1.0",
  "description": "Private, file-backed feedback capture and a terminal board for Pi and pi-research.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/jrhuebers/pi-feedback.git" },
  "keywords": ["pi-package", "pi-extension", "feedback", "kanban"],
  "files": ["src", "README.md", "CHANGELOG.md", "LICENSE"],
  "pi": { "extensions": ["./src/index.ts"] },
  "engines": { "node": ">=22" },
  "scripts": { "test": "tsx --test tests/*.test.ts", "typecheck": "tsc --noEmit", "test:smoke": "node tests/rpc-smoke.mjs", "test:tui": "python3 tests/tui-smoke.py" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
